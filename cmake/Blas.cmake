option(WEED_BLAS "Use OpenBLAS for matmul" ON)
if(WEED_BLAS)
    if(MSVC OR (APPLE AND (NOT ${CMAKE_SYSTEM_PROCESSOR} STREQUAL "arm64")))
        find_package(OpenBLAS CONFIG)
        if(OpenBLAS_FOUND)
            target_include_directories(weed PUBLIC ${OpenBLAS_INCLUDE_DIRS})
            target_link_libraries(weed PUBLIC OpenBLAS::OpenBLAS)
        else()
            message(STATUS "OpenBLAS not found: falling back to built-in matmul")
            set(WEED_BLAS OFF)
        endif()
    else()
        find_package(BLAS)
        if(APPLE)
            # Accelerate ships its own CBLAS header
            set(WEED_CBLAS_INCLUDE_DIR "")
            set(WEED_CBLAS_HEADER_FOUND ${BLAS_FOUND})
        else()
            # A Fortran-only BLAS (no cblas.h) can't be used by matmul.cpp
            find_path(WEED_CBLAS_INCLUDE_DIR cblas.h
                PATH_SUFFIXES openblas openblas-pthread openblas-openmp)
            if(WEED_CBLAS_INCLUDE_DIR)
                set(WEED_CBLAS_HEADER_FOUND ON)
            else()
                set(WEED_CBLAS_HEADER_FOUND OFF)
            endif()
        endif()
        if(BLAS_FOUND AND WEED_CBLAS_HEADER_FOUND)
            if(WEED_CBLAS_INCLUDE_DIR)
                target_include_directories(weed PUBLIC ${WEED_CBLAS_INCLUDE_DIR})
            endif()
            target_link_libraries(weed PUBLIC ${BLAS_LIBRARIES})
            if(APPLE)
                target_compile_definitions(weed PRIVATE ACCELERATE_NEW_LAPACK)
            endif()
        else()
            message(STATUS "BLAS (with cblas.h) not found: falling back to built-in matmul")
            set(WEED_BLAS OFF)
        endif()
    endif()
endif()
